{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"python.terminal.useEnvFile": true,
		"cSpell.words": [
			"natsorted",
			"raiplay"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Python: Main",
				"type": "python",
				"request": "launch",
				"program": "${workspaceFolder}/src/main.py",
				"console": "integratedTerminal",
				"args": [
					"https://www.raiplay.it/programmi/blob",
					"--list-formats",
				]
			}
		]
	}
}